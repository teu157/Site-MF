rflow:hidden;background:#080b09\">\n\n<nav style=\"position:fixed;top:0;left:0;right:0;z-index:60;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px clamp(16px,4vw,40px);background:rgba(8,11,9,.72);backdrop-filter:blur(14px);border-bottom:1px solid rgba(238,242,238,.09);animation:mfFade .8s ease .1s both\">\n  <a href=\"#topo\" style=\"display:flex;align-items:center;gap:10px;color:#eef2ee\">\n    <img src=\"365f9974-b69a-42d1-bae6-425cec8514cc\" alt=\"\" style=\"height:34px;width:auto\">\n    <img src=\"351a7ae2-946d-43c0-a040-ccee4ad80531\" alt=\"MF Sportswear\" style=\"height:15px;width:auto\">\n  <\u002Fa>\n  <div id=\"mfMenu\" style=\"display:flex;align-items:center;gap:clamp(14px,3vw,30px);font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase\">\n    <a href=\"#tenis\" style=\"color:#93a099;display:none\" style-hover=\"color:#eef2ee\">Tênis<\u002Fa>\n    <a href=\"#camisas\" style=\"color:#93a099;display:none\" style-hover=\"color:#eef2ee\">Camisas<\u002Fa>\n    <a href=\"#como\" style=\"color:#93a099;display:none\" style-hover=\"color:#eef2ee\">Como funciona<\u002Fa>\n    <a href=\"#duvidas\" style=\"color:#93a099;display:none\" style-hover=\"color:#eef2ee\">Dúvidas<\u002Fa>\n    <a href=\"https://wa.me/5538997506508?text=Oi%21%20Vim%20pelo%20site%20da%20MF%20Sportswear%20e%20quero%20saber%20mais.\" target=\"_blank\" rel=\"noopener\" style=\"display:inline-flex;align-items:center;gap:7px;min-height:40px;padding:0 18px;border-radius:999px;background:#4fb98d;color:#080b09;font-weight:700;letter-spacing:.1em\" style-hover=\"background:#7fd9b0;color:#080b09\">\n      <svg sc-camel-view-box=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm4.52 12.14c-.25-.13-1.47-.72