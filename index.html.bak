 <span style=\"font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:#4fb98d\">02 / Camisas<\u002Fspan>\n      <h2 style=\"margin-top:14px;font-family:'Bebas Neue',sans-serif;font-weight:400;font-size:clamp(38px,7vw,92px);line-height:.92;letter-spacing:.01em;text-transform:uppercase;color:#eef2ee\">Frente e costas,<br>sem surpresa<\u002Fh2>\n    <\u002Fdiv>\n    <p style=\"max-width:34ch;font-size:15px;line-height:1.6;color:#93a099;font-weight:300\">Ninguém compra camisa vendo só a frente. Passe o dedo no cartão para virar cada uma.<\u002Fp>\n  <\u002Fdiv>\n\n  <div class=\"mf-reveal\" style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(215px,1fr));gap:clamp(12px,1.6vw,20px);margin-top:clamp(32px,5vw,56px)\">\n    <article style=\"border:1px solid rgba(238,242,238,.11);border-radius:4px;overflow:hidden;background:#0d1210;transition:border-color .4s ease\" style-hover=\"border-color:rgba(79,185,141,.44)\">\n      <div style=\"position:relative;aspect-ratio:3/4;perspective:1400px;background:#101512;cursor:pointer\" style-hover=\"--mf-flip:180deg\">\n        <div style=\"position:absolute;inset:0;transform-style:preserve-3d;transform:rotateY(var(--mf-flip,0deg));transition:transform .9s cubic-bezier(.16,1,.3,1)\">\n          <div style=\"position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden\"><img src=\"76dedb75-077c-42d6-af90-fcd6fc236928\" alt=\"Camisa do Brasil amarela, frente\" loading=\"lazy\" style=\"width:100%;height:100%;object-fit:cover\"><\u002Fdiv>\n          <div style=\"position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;transform:rotateY(180deg)\"><img src=\"43fab31a-edf8-4136-aaeb-a372b186d24f\" alt=\"Camisa do Brasil amarela, costas\" loading=\"lazy\" style=\"width:100%;height:100%;object-fit:cover\"><\u002Fdiv>\n        <\u002Fdiv>\n        <span style=\"position:absolute;left:12px;bottom:12px;z-index:4;font-family:'Space Mono',monospace;font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;color:#eef2ee;background:rgba(8,11,9,.82);border:1px solid rgba(127,217,176,.34);border-radius:999px;padding:6px 12px\">Vire ↺<\u002Fspan>\n      <\u002Fdiv>\n      <div style=\"padding:16px 18px 20px\">\n        <h3 style=\"font-family:'Bebas Neue',sans-serif;font-weight:400;font-size:24px;letter-spacing:.02em;text-transform:uppercase\">Brasil amarela<\u002Fh3>\n        <p style=\"margin-top:7px;font-size:13.5px;line-height:1.55;color:#93a099;font-weight:300\">Gola verde escura e escudo bordado.<\u002Fp>\n        <a href=\"https://wa.me/5538997506508?text=Oi%21%20Quero%20saber%20sobre%20a%20camisa%20do%20Brasil%20amarela.\" target=\"_blank\" rel=\"noopener\" style=\"display:inline-block;margin-top:12px;font-size:13.5px;color:#4fb98d\" style-hover=\"color:#7fd9b0\">Consultar →<\u002Fa>\n      <\u002Fdiv>\n    <\u002Farticle>\n\n    <article style=\"border:1px solid rgba(238,242,238,.11);border-radius:4px;overflow:hidden;background:#0d1210;transition:border-color .4s ease\" style-hover=\"border-color:rgba(79,185,141,.44)\">\n      <div style=\"position:relative;aspect-ratio:3/4;perspective:1400px;background:#101512;cursor:pointer\" style-hover=\"--mf-flip:180deg\">\n        <div style=\"position:absolute;inset:0;transform-style:preserve-3d;transform:rotateY(var(--mf-flip,0deg));transition:transform .9s cubic-bezier(.16,1,.3,1)\">\n          <div style=\"position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden\"><img src=\"77f679d8-ce1f-4939-92de-bf9232f57b59\" alt=\"Camisa do Brasil verde água, frente\" loading=\"lazy\" style=\"width:100%;height:100%;object-fit:cover\"><\u002Fdiv>\n          <div style=\"position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;transform:rotateY(180deg)\"><img src=\"36866e06-4489-40a5-ab98-4c18d89cc48b\" alt=\"Camisa do Brasil verde água, costas\" loading=\"lazy\" style=\"width:100%;height:100%;object-fit:cover\"><\u002Fdiv>\n        <\u002Fdiv>\n        <span style=\"position:absolute;left:12px;bottom:12px;z-index:4;font-family:'Space Mono',monospace;font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;color:#eef2ee;background:rgba(8,11,9,.82);border:1px solid rgba(127,217,176,.34);border-radius:999px;padding:6px 12px\">Vire ↺<\u002Fspan>\n      <\u002Fdiv>\n      <div style=\"padding:16px 18px 20px\">\n        <h3 style=\"font-family:'Bebas Neue',sans-serif;font-weight:400;font-size:24px;letter-spacing:.02em;text-transform:uppercase\">Brasil verde<\u002Fh3>\n        <p style=\"margin-top:7px;font-size:13.5px;line-height:1.55;color:#93a099;font-weight:300\">Verde água com grafismo preto, escudo tom sobre tom.<\u002Fp>\n        <a href=\"https://wa.me/5538997506508?text=Oi%21%20Quero%20saber%20sobre%20a%20camisa%20do%20Brasil%20verde.\" target=\"_blank\" rel=\"noopener\" style=\"display:inline-block;margin-top:12px;font-size:13.5px;color:#4fb98d\" style-hover=\"color:#7fd9b0\">Consultar →<\u002Fa>\n      <\u002Fdiv>\n    <\u002Farticle>\n\n    <article style=\"border:1px solid rgba(238,242,238,.11);border-radius:4px;overflow:hidden;background:#0d1210;transition:border-color .4s ease\" style-hover=\"border-color:rgba(79,185,141,.44)\">\n      <div style=\"position:relative;aspect-ratio:3/4;perspective:1400px;background:#101512;cursor:pointer\" style-hover=\"--mf-flip:180deg\">\n        <div style=\"position:absolute;inset:0;transform-style:preserve-3d;transform:rotateY(var(--mf-flip,0deg));transition:transform .9s cubic-bezier(.16,1,.3,1)\">\n          <div style=\"position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden\"><img src=\"dd189d11-dae4-496e-ac0b-99a234f377e5\" alt=\"Camisa do Atlético Mineiro listrada, frente\" loading=\"lazy\" style=\"width:100%;height:100%;object-fit:cover\"><\u002Fdiv>\n          <div style=\"position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;transform:rotateY(180deg)\"><img src=\"d6c55689-e7c5-40e1-a5f4-9582152fe158\" alt=\"Camisa do Atlético Mineiro listrada, costas\" loading=\"lazy\" style=\"width:100%;height:100%;object-fit:cover\"><\u002Fdiv>\n        <\u002Fdiv>\n        <span style=\"position:absolute;left:12px;bottom:12px;z-index:4;font-family:'Space Mono',monospace;font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;color:#eef2ee;background:rgba(8,11,9,.82);border:1px solid rgba(127,217,176,.34);border-radius:999px;padding:6px 12px\">Vire ↺<\u002Fspan>\n      <\u002Fdiv>\n      <div style=\"padding:16px 18px 20px\">\n        <h3 style=\"font-family:'Bebas Neue',sans-serif;font-weight:400;font-size:24px;letter-spacing:.02em;text-transform:uppercase\">Atlético Mineiro<\u002Fh3>\n        <p style=\"margin-top:7px;font-size:13.5px;line-height:1.55;color:#93a099;font-weight:300\">Listras pretas e brancas com filete dourado.<\u002Fp>\n        <a href=\"https://wa.me/5538997506508?text=Oi%21%20Quero%20saber%20sobre%20a%20camisa%20do%20Atl%C3%A9tico%20Mineiro.\" target=\"_blank\" rel=\"noopener\" style=\"display:inline-block;margin-top:12px;font-size:13.5px;color:#4fb98d\" style-hover=\"color:#7fd9b0\">Consultar →<\u002Fa>\n      <\u002Fdiv>\n    <\u002Farticle>\n\n    <article style=\"border:1px solid rgba(238,242,238,.11);border-radius:4px;overflow:hidden;background:#0d1210;transition:border-color .4s ease\" style-hover=\"border-color:rgba(79,185,141,.44)\">\n      <div style=\"position:relative;aspect-ratio:3/4;perspective:1400px;background:#101512;cursor:pointer\" style-hover=\"--mf-flip:180deg\">\n        <div style=\"position:absolute;inset:0;transform-style:preserve-3d;transform:rotateY(var(--mf-flip,0deg));transition:transform .9s cubic-bezier(.16,1,.3,1)\">\n          <div style=\"position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden\"><img src=\"c4d315b6-b0b3-48ed-a591-c7b7fc5d22a9\" alt=\"Camisa do Cruzeiro azul, frente\" loading=\"lazy\" style=\"width:100%;height:100%;object-fit:cover\"><\u002Fdiv>\n          <div style=\"position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;transform:rotateY(180deg)\"><img src=\"597fcfc5-aee1-4698-8886-d3249ba81f80\" alt=\"Camisa do Cruzeiro azul, costas\" loading=\"lazy\" style=\"width:100%;height:100%;object-fit:cover\"><\u002Fdiv>\n        <\u002Fdiv>\n        <span style=\"position:absolute;left:12px;bottom:12px;z-index:4;font-family:'Space Mono',monospace;font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;color:#eef2ee;background:rgba(8,11,9,.82);border:1px solid rgba(127,217,176,.34);border-radius:999px;padding:6px 12px\">Vire ↺<\u002Fspan>\n      <\u002Fdiv>\n      <div style=\"padding:16px 18px 20px\">\n        <h3 style=\"font-family:'Bebas Neue',sans-serif;font-weight:400;font-size:24px;letter-spacing:.02em;text-transform:uppercase\">Cruzeiro<\u002Fh3>\n        <p style=\"margin-top:7px;font-size:13.5px;line-height:1.55;color:#93a099;font-weight:300\">Azul com o cruzeiro do sul em branco e textura tom sobre tom.<\u002Fp>\n        <a href=\"https://wa.me/5538997506508?text=Oi%21%20Quero%20saber%20sobre%20a%20camisa%20do%20Cruzeiro.\" target=\"_blank\" rel=\"noopener\" style=\"display:inline-block;margin-top:12px;font-size:13.5px;color:#4fb98d\" style-hover=\"color:#7fd9b0\">Consultar →<\u002Fa>\n      <\u002Fdiv>\n    <\u002Farticle>\n  <\u002Fdiv>\n<\u002Fsection>\n\n<section id=\"como\" style=\"padding:clamp(56px,8vw,104px) clamp(16px,4vw,40px);max-width:1440px;margin:0 auto\">\n  <div class=\"mf-reveal\" style=\"border-bottom:1px solid rgba(238,242,238,.12);padding-bottom:26px\">\n    <span style=\"font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:#4fb98d\">03 / Como funciona<\u002Fspan>\n    <h2 style=\"margin-top:14px;font-family:'Bebas Neue',sans-serif;font-weight:400;font-size:clamp(38px,7vw,92px);line-height:.92;letter-spacing:.01em;text-transform:uppercase;color:#eef2ee\">Três passos, sem mistério<\u002Fh2>\n  <\u002Fdiv>\n  <div id=\"mfLinha\" data-cor-ativa=\"#4fb98d\" data-cor-inativa=\"#2e5e49\" style=\"position:relative;height:1px;margin-top:clamp(36px,5vw,58px);background:rgba(238,242,238,.11)\">\n    <span id=\"mfLinhaProg\" style=\"position:absolute;left:0;top:0;height:1px;width:0%;background:#4fb98d\"><\u002Fspan>\n    <span class=\"mf-ponto\" data-marco=\"0.03\" style=\"position:absolute;left:0;top:-4px;width:9px;height:9px;border-radius:50%;background:#2e5e49\"><\u002Fspan>\n    <span class=\"mf-ponto\" data-marco=\"0.5\" style=\"position:absolute;left:50%;margin-left:-4.5px;top:-4px;width:9px;height:9px;border-radius:50%;background:#2e5e49\"><\u002Fspan>\n    <span class=\"mf-ponto\" data-marco=\"0.96\" style=\"position:absolute;right:0;top:-4px;width:9px;height:9px;border-radius:50%;background:#2e5e49\"><\u002Fspan>\n  <\u002Fdiv>\n  <div class=\"mf-reveal\" style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(258px,1fr));gap:1px;margin-top:clamp(22px,2.8vw,32px);background:rgba(238,242,238,.11)\">\n    <div class=\"mf-luz\" data-luz=\"rgba(79,185,141,.16)\" style=\"position:relative;overflow:hidden;background:#080b09;padding:clamp(24px,3vw,38px) clamp(20px,2.4vw,32px)\">\n      <span class=\"mf-marco\" data-marco=\"0.2\" style=\"font-family:'Bebas Neue',sans-serif;font-size:56px;line-height:1;color:#2e5e49\">01<\u002Fspan>\n      <h3 style=\"margin-top:14px;font-size:19px;font-weight:600;letter-spacing:-.01em\">Você escolhe<\u002Fh3>\n      <p style=\"margin-top:10px;font-size:14.5px;line-height:1.62;color:#93a099;font-weight:300\">Manda o modelo e o tamanho no WhatsApp. Eu confirmo na hora se está aqui.<\u002Fp>\n    <\u002Fdiv>\n    <div class=\"mf-luz\" data-luz=\"rgba(79,185,141,.16)\" style=\"position:relative;overflow:hidden;background:#080b09;padding:clamp(24px,3vw,38px) clamp(20px,2.4vw,32px)\">\n      <span class=\"mf-marco\" data-marco=\"0.5\" style=\"font-family:'Bebas Neue',sans-serif;font-size:56px;line-height:1;color:#2e5e49\">02<\u002Fspan>\n      <h3 style=\"margin-top:14px;font-size:19px;font-weight:600;letter-spacing:-.01em\">A gente acerta<\u002Fh3>\n      <p style=\"margin-top:10px;font-size:14.5px;line-height:1.62;color:#93a099;font-weight:300\">Preço, pagamento e prazo na conversa. Sem cadastro, sem carrinho.<\u002Fp>\n    <\u002Fdiv>\n    <div class=\"mf-luz\" data-luz=\"rgba(79,185,141,.16)\" style=\"position:relative;overflow:hidden;background:#080b09;padding:clamp(24px,3vw,38px) clamp(20px,2.4vw,32px)\">\n      <span class=\"mf-marco\" data-marco=\"0.8\" style=\"font-family:'Bebas Neue',sans-serif;font-size:56px;line-height:1;color:#2e5e49\">03<\u002Fspan>\n      <h3 style=\"margin-top:14px;font-size:19px;font-weight:600;letter-spacing:-.01em\">Chega na sua casa<\u002Fh3>\n      <p style=\"margin-top:10px;font-size:14.5px;line-height:1.62;color:#93a099;font-weight:300\">Envio por transportadora para todo o Brasil, com código de rastreio.<\u002Fp>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fsection>\n\n<section id=\"sobre\" style=\"position:relative;margin-top:clamp(24px,4vw,56px);background:#0d1210;border-top:1px solid rgba(238,242,238,.1);border-bottom:1px solid rgba(238,242,238,.1)\">\n  <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(420px,1fr));align-items:stretch;max-width:1440px;margin:0 auto\">\n    <div style=\"position:relative;min-height:clamp(320px,50vw,620px);overflow:hidden;background:#101512\">\n      <img src=\"b7c4ac79-7fe8-445b-9e6f-3c0d797cb98b\" alt=\"Matheus no palco apresentando a MF Sportswear, com a logo da marca no telão atrás\" loading=\"lazy\" style=\"position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 26%\">\n      <div style=\"position:absolute;inset:0;background:linear-gradient(to top,rgba(13,18,16,.85),transparent 55%)\"><\u002Fdiv>\n      <span style=\"position:absolute;left:clamp(16px,3vw,28px);bottom:clamp(16px,3vw,26px);font-family:'Space Mono',monospace;font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:#93a099\">Apresentando a MF Sportswear<\u002Fspan>\n    <\u002Fdiv>\n    <div class=\"mf-reveal\" style=\"padding:clamp(40px,6vw,84px) clamp(16px,4vw,64px);display:flex;flex-direction:column;justify-content:center;gap:22px\">\n      <span style=\"font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:#4fb98d\">04 / Quem vende<\u002Fspan>\n      <h2 style=\"font-family:'Bebas Neue',sans-serif;font-weight:400;font-size:clamp(38px,6vw,78px);line-height:.94;letter-spacing:.01em;text-transform:uppercase;color:#eef2ee\">Meu nome é<br>Matheus<\u002Fh2>\n      <p style=\"max-width:46ch;font-size:clamp(15px,1.5vw,17px);line-height:1.66;color:#c3ccc6;font-weight:300\">Eu escolho cada peça que entra, tiro as fotos que você acabou de ver e respondo o WhatsApp eu mesmo. Sem intermediário, sem atendente.<\u002Fp>\n      <p id=\"mfManifesto\" data-cor-ativa=\"#4fb98d\" data-cor-inativa=\"rgba(238,242,238,.22)\" style=\"max-width:30ch;font-family:'Bebas Neue',sans-serif;font-size:clamp(24px,2.8vw,36px);line-height:1.05;letter-spacing:.01em;text-transform:uppercase;color:#4fb98d\">Se um par não passa na minha mão, ele não entra no site.<\u002Fp>\n      <div style=\"display:flex;flex-wrap:wrap;gap:26px;border-top:1px solid rgba(238,242,238,.12);padding-top:20px;font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#93a099\">\n        <span>Envio nacional<\u002Fspan>\n        <span>Rastreio sempre<\u002Fspan>\n        <span>Foto antes de pagar<\u002Fspan>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fsection>\n\n<section id=\"duvidas\" style=\"padding:clamp(56px,8vw,104px) clamp(16px,4vw,40px);max-width:1440px;margin:0 auto\">\n  <div class=\"mf-reveal\" style=\"display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:24px;border-bottom:1px solid rgba(238,242,238,.12);padding-bottom:26px\">\n    <div>\n      <span style=\"font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:#4fb98d\">05 / Dúvidas<\u002Fspan>\n      <h2 style=\"margin-top:14px;font-family:'Bebas Neue',sans-serif;font-weight:400;font-size:clamp(38px,7vw,92px);line-height:.92;letter-spacing:.01em;text-transform:uppercase;color:#eef2ee\">As perguntas que<br>sempre chegam<\u002Fh2>\n    <\u002Fdiv>\n    <p style=\"max-width:30ch;font-size:15px;line-height:1.6;color:#93a099;font-weight:300\">Resposta direta, sem enrolação.<\u002Fp>\n  <\u002Fdiv>\n  <div class=\"mf-reveal\" style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:clamp(24px,3vw,44px) clamp(32px,5vw,80px);margin-top:clamp(32px,5vw,56px)\">\n    <div style=\"border-top:1px solid rgba(238,242,238,.12);padding-top:20px\">\n      <h3 style=\"font-size:18px;font-weight:600;letter-spacing:-.01em\">Como eu sei que não é golpe?<\u002Fh3>\n      <p style=\"margin-top:10px;font-size:14.5px;line-height:1.64;color:#93a099;font-weight:300\">Você fala comigo direto, vê meu nome e meu rosto aqui em cima, e recebe o código de rastreio quando o pacote sai. Antes de fechar a caixa eu te mando foto ou vídeo do seu par.<\u002Fp>\n    <\u002Fdiv>\n    <div style=\"border-top:1px solid rgba(238,242,238,.12);padding-top:20px\">\n      <h3 style=\"font-size:18px;font-weight:600;letter-spacing:-.01em\">É original?<\u002Fh3>\n      <p style=\"margin-top:10px;font-size:14.5px;line-height:1.64;color:#93a099;font-weight:300\">É importado, linha premium. Eu não vendo como original de loja oficial, e prefiro te falar isso agora do que te decepcionar depois.<\u002Fp>\n    <\u002Fdiv>\n    <div style=\"border-top:1px solid rgba(238,242,238,.12);padding-top:20px\">\n      <h3 style=\"font-size:18px;font-weight:600;letter-spacing:-.01em\">Quanto tempo demora para chegar?<\u002Fh3>\n      <p style=\"margin-top:10px;font-size:14.5px;line-height:1.64;color:#93a099;font-weight:300\">O que está em estoque sai rápido e você recebe o rastreio. Encomenda depende do fornecedor, e eu te passo o prazo real antes de você pagar.<\u002Fp>\n    <\u002Fdiv>\n    <div style=\"border-top:1px solid rgba(238,242,238,.12);padding-top:20px\">\n      <h3 style=\"font-size:18px;font-weight:600;letter-spacing:-.01em\">E se o tamanho não servir?<\u002Fh3>\n      <p style=\"margin-top:10px;font-size:14.5px;line-height:1.64;color:#93a099;font-weight:300\">Me manda a medida do seu pé em centímetros antes de fechar. A gente acerta o número na conversa.<\u002Fp>\n    <\u002Fdiv>\n    <div style=\"border-top:1px solid rgba(238,242,238,.12);padding-top:20px\">\n      <h3 style=\"font-size:18px;font-weight:600;letter-spacing:-.01em\">Vocês entregam onde?<\u002Fh3>\n      <p style=\"margin-top:10px;font-size:14.5px;line-height:1.64;color:#93a099;font-weight:300\">Todo o Brasil, por transportadora, com código de rastreio em toda compra.<\u002Fp>\n    <\u002Fdiv>\n    <div style=\"border-top:1px solid rgba(238,242,238,.12);padding-top:20px\">\n      <h3 style=\"font-size:18px;font-weight:600;letter-spacing:-.01em\">Dá para ver a peça antes de pagar?<\u002Fh3>\n      <p style=\"margin-top:10px;font-size:14.5px;line-height:1.64;color:#93a099;font-weight:300\">Dá. Peço foto ou vídeo do item exato e te mando na conversa, antes de qualquer pagamento.<\u002Fp>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fsection>\n\n<section id=\"falar\" style=\"position:relative;overflow:hidden;padding:clamp(72px,12vw,160px) clamp(16px,4vw,40px);background:#4fb98d;color:#06110c\">\n  <div style=\"position:absolute;inset:0;background:radial-gradient(ellipse 60% 70% at 78% 20%,rgba(255,255,255,.28),transparent 70%)\"><\u002Fdiv>\n  <div class=\"mf-reveal\" style=\"position:relative;max-width:1200px;margin:0 auto;display:flex;flex-direction:column;gap:clamp(24px,4vw,44px)\">\n    <span style=\"font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:rgba(6,17,12,.62)\">06 / Chamada final<\u002Fspan>\n    <h2 style=\"font-family:'Bebas Neue',sans-serif;font-weight:400;font-size:clamp(54px,14vw,200px);line-height:.84;letter-spacing:.01em;text-transform:uppercase\">Escolheu?<br>Me chama.<\u002Fh2>\n    <div style=\"display:flex;flex-wrap:wrap;align-items:center;gap:clamp(18px,3vw,36px);border-top:1px solid rgba(6,17,12,.22);padding-top:clamp(20px,3vw,32px)\">\n      <a href=\"https://wa.me/5538997506508?text=Oi%21%20Vim%20pelo%20site%20da%20MF%20Sportswear%20e%20quero%20saber%20mais.\" target=\"_blank\" rel=\"noopener\" style=\"display:inline-flex;align-items:center;gap:12px;min-height:58px;padding:0 14px 0 8px;border-radius:999px;background:#06110c;color:#eef2ee;font-size:16px;font-weight:600;transition:transform .3s ease\" class=\"mf-mola\" style-hover=\"color:#eef2ee\">\n        <img src=\"b7c4ac79-7fe8-445b-9e6f-3c0d797cb98b\" alt=\"\" loading=\"lazy\" style=\"width:42px;height:42px;border-radius:50%;object-fit:cover;object-position:33% 24%\">\n        <span style=\"padding-right:14px\">Chamar no WhatsApp<\u002Fspan>\n      <\u002Fa>\n      <p style=\"max-width:38ch;font-size:14.5px;line-height:1.6;color:rgba(6,17,12,.76)\">Respondo normalmente em minutos. Abre uma conversa com (38) 99750-6508. Nada é enviado por este site.<\u002Fp>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fsection>\n\n<footer style=\"padding:clamp(40px,6vw,72px) clamp(16px,4vw,40px) 32px;max-width:1440px;margin:0 auto\">\n  <div style=\"display:flex;flex-wrap:wrap;gap:clamp(28px,5vw,72px);justify-content:space-between;align-items:flex-start\">\n    <div style=\"display:flex;flex-direction:column;gap:14px\">\n      <img src=\"243f7afa-b9d9-4efb-b147-895257b21ce8\" alt=\"MF Sportswear\" style=\"width:158px;height:auto\">\n      <p style=\"font-family:'Space Mono',monospace;font-size:11.5px;letter-spacing:.1em;color:#93a099\">(38) 99750-6508 · @mfsports_wear<\u002Fp>\n    <\u002Fdiv>\n    <div style=\"display:flex;gap:clamp(28px,5vw,64px)\">\n      <nav style=\"display:flex;flex-direction:column;gap:10px;font-size:14px\">\n        <a href=\"#tenis\" style=\"color:#93a099\" style-hover=\"color:#4fb98d\">Tênis<\u002Fa>\n        <a href=\"#camisas\" style=\"color:#93a099\" style-hover=\"color:#4fb98d\">Camisas<\u002Fa>\n        <a href=\"#como\" style=\"color:#93a099\" style-hover=\"color:#4fb98d\">Como funciona<\u002Fa>\n        <a href=\"#duvidas\" style=\"color:#93a099\" style-hover=\"color:#4fb98d\">Dúvidas<\u002Fa>\n      <\u002Fnav>\n      <nav style=\"display:flex;flex-direction:column;gap:10px;font-size:14px\">\n        <a href=\"https://wa.me/5538997506508?text=Oi%21%20Vim%20pelo%20site%20da%20MF%20Sportswear%20e%20quero%20saber%20mais.\" target=\"_blank\" rel=\"noopener\" style=\"color:#93a099\" style-hover=\"color:#4fb98d\">WhatsApp<\u002Fa>\n        <a href=\"https://instagram.com/mfsports_wear\" target=\"_blank\" rel=\"noopener\" style=\"color:#93a099\" style-hover=\"color:#4fb98d\">Instagram<\u002Fa>\n      <\u002Fnav>\n    <\u002Fdiv>\n  <\u002Fdiv>\n  <p style=\"margin-top:clamp(28px,4vw,48px);padding-top:18px;border-top:1px solid rgba(238,242,238,.1);font-size:12px;line-height:1.7;color:#5f6f66;max-width:80ch\">Produtos importados, linha premium. Nike, Jordan, adidas e os clubes citados são marcas dos seus respectivos donos e não têm nenhuma relação com a MF Sportswear. As fotos deste site são das peças que passaram pelo nosso estoque.<\u002Fp>\n<\u002Ffooter>\n\n<\u002Fdiv>\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\">\nclass Component extends DCLogic {\n  componentDidMount() {\n    this.armarVideo();\n    this.armarRevelacoes();\n    this.armarNav();\n    this.armarMovimento();\n    this.armarLuz();\n    this.armarMola();\n  }\n\n  /* O vídeo: muted + playsInline definidos antes do play, poster pintado\n     enquanto carrega, e botão de toque só se o navegador barrar o autoplay. */\n  armarVideo() {\n    const v = document.getElementById('mfHeroVideo');\n    const btn = document.getElementById('mfPlayBtn');\n    if (!v) return;\n    v.muted = true;\n    v.defaultMuted = true;\n    v.loop = true;\n    v.playsInline = true;\n    v.setAttribute('playsinline', '');\n    v.setAttribute('webkit-playsinline', '');\n\n    const reduzido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n    const mostrarBotao = () => { if (btn) btn.style.display = 'inline-flex'; };\n    const esconderBotao = () => { if (btn) btn.style.display = 'none'; };\n\n    const tocar = () => {\n      const p = v.play();\n      if (p && p.catch) p.catch(mostrarBotao);\n    };\n\n    if (btn) {\n      btn.addEventListener('click', () => { esconderBotao(); tocar(); });\n    }\n    v.addEventListener('playing', esconderBotao);\n    v.addEventListener('error', mostrarBotao);\n    v.addEventListener('stalled', mostrarBotao);\n\n    {\n      /* o vídeo é o conteúdo do hero, então toca sempre: mudo e em loop.\n         movimento reduzido continua valendo para as animações decorativas. */\n      tocar();\n      v.addEventListener('loadeddata', tocar, { once: true });\n      /* alguns navegadores só liberam o autoplay depois da aba ganhar foco\n         ou do primeiro toque: tentamos de novo nesses dois momentos */\n      const retentar = () => { if (v.paused && !document.hidden) tocar(); };\n      document.addEventListener('visibilitychange', retentar);\n      window.addEventListener('focus', retentar);\n      window.addEventListener('pointerdown', retentar, { once: true });\n      window.addEventListener('scroll', retentar, { passive: true, once: true });\n      this._retentativas = 0;\n      this._timer = setInterval(() => {\n        this._retentativas += 1;\n        if (!v.paused || this._retentativas > 6) { clearInterval(this._timer); this._timer = null; return; }\n        tocar();\n      }, 700);\n    }\n\n    /* pausa quando o hero sai da tela, volta quando entra */\n    if ('IntersectionObserver' in window) {\n      this._io = new IntersectionObserver((es) => {\n        es.forEach((e) => {\n          if (e.isIntersecting) { this._jaViu = true; if (v.paused) tocar(); }\n          else if (this._jaViu && !v.paused) v.pause();\n        });\n      }, { threshold: 0.08 });\n      this._io.observe(v);\n    }\n  }\n\n  /* Revelações no scroll. Usa animation-timeline quando existe; onde não\n     existe, o conteúdo simplesmente aparece sem animação. */\n  armarRevelacoes() {\n    const alvos = Array.prototype.slice.call(document.querySelectorAll('.mf-reveal'));\n    if (!alvos.length) return;\n    const suporta = window.CSS && CSS.supports && CSS.supports('animation-timeline', 'view()');\n    const reduzido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n    if (!suporta || reduzido) return;\n    alvos.forEach((el) => {\n      el.style.setProperty('animation', 'mfReveal .9s cubic-bezier(.16,1,.3,1) both');\n      el.style.setProperty('animation-timeline', 'view()');\n      el.style.setProperty('animation-range', 'entry 4% cover 26%');\n    });\n  }\n\n  /* Os links do menu só aparecem quando há largura para eles. */\n  armarNav() {\n    const links = Array.prototype.slice.call(document.querySelectorAll('#mfMenu a[href^=\"#\"]'));\n    const aplicar = () => {\n      const largo = window.innerWidth >= 860;\n      links.forEach((a) => { a.style.display = largo ? 'inline-block' : 'none'; });\n    };\n    aplicar();\n    this._resize = aplicar;\n    window.addEventListener('resize', aplicar);\n  }\n\n  /* Rolagem como controle contínuo (04 e 07 da referência): um único\n     listener em requestAnimationFrame alimenta todos os efeitos. */\n  armarMovimento() {\n    const tarefas = [].concat(this.prepararTextoQuePreenche(), this.prepararLinhaTempo());\n    if (!tarefas.length) return;\n    let agendado = false;\n    const rodar = () => { agendado = false; tarefas.forEach((t) => t()); };\n    const aoRolar = () => { if (!agendado) { agendado = true; requestAnimationFrame(rodar); } };\n    window.addEventListener('scroll', aoRolar, { passive: true });\n    window.addEventListener('resize', aoRolar);\n    this._aoRolar = aoRolar;\n    rodar();\n  }\n\n  /* 04 — o manifesto acende palavra por palavra conforme a rolagem passa. */\n  prepararTextoQuePreenche() {\n    const el = document.getElementById('mfManifesto');\n    if (!el) return [];\n    const ativa = el.getAttribute('data-cor-ativa');\n    const inativa = el.getAttribute('data-cor-inativa');\n    const palavras = el.textContent.trim().split(/\\s+/).filter(Boolean);\n    if (palavras.length < 2) return [];\n    el.textContent = '';\n    const spans = palavras.map((p, i) => {\n      const s = document.createElement('span');\n      s.textContent = p;\n      s.style.color = inativa;\n      s.style.transition = 'color .5s ease';\n      el.appendChild(s);\n      if (i < palavras.length - 1) el.appendChild(document.createTextNode(' '));\n      return s;\n    });\n    return [() => {\n      const r = el.getBoundingClientRect();\n      const inicio = window.innerHeight * 0.88;\n      const fim = window.innerHeight * 0.34;\n      const p = Math.max(0, Math.min(1, (inicio - r.top) / Math.max(1, inicio - fim)));\n      const alvo = p * (spans.length + 2);\n      spans.forEach((s, i) => { s.style.color = alvo > i + 0.5 ? ativa : inativa; });\n    }];\n  }\n\n  /* 07 — a linha dos três passos se desenha e cada marco acende quando ela chega. */\n  prepararLinhaTempo() {\n    const trilha = document.getElementById('mfLinha');\n    const prog = document.getElementById('mfLinhaProg');\n    const secao = document.getElementById('como');\n    if (!trilha || !prog || !secao) return [];\n    const ativa = trilha.getAttribute('data-cor-ativa');\n    const inativa = trilha.getAttribute('data-cor-inativa');\n    const marcos = Array.prototype.slice.call(secao.querySelectorAll('.mf-marco'));\n    const pontos = Array.prototype.slice.call(trilha.querySelectorAll('.mf-ponto'));\n    marcos.forEach((m) => { m.style.transition = 'color .5s ease'; });\n    pontos.forEach((pt) => { pt.style.transition = 'background-color .4s ease,transform .4s cubic-bezier(.16,1,.3,1)'; pt.style.transform = 'scale(.55)'; });\n    prog.style.transition = 'width .12s linear';\n    return [() => {\n      const r = secao.getBoundingClientRect();\n      const p = Math.max(0, Math.min(1, (window.innerHeight * 0.86 - r.top) / (window.innerHeight * 0.62)));\n      prog.style.width = (p * 100).toFixed(2) + '%';\n      marcos.forEach((m) => { m.style.color = p >= parseFloat(m.getAttribute('data-marco')) ? ativa : inativa; });\n      pontos.forEach((pt) => {\n        const on = p >= parseFloat(pt.getAttribute('data-marco'));\n        pt.style.backgroundColor = on ? ativa : inativa;\n        pt.style.transform = on ? 'scale(1)' : 'scale(.55)';\n      });\n    }];\n  }\n\n  /* 12 — o JS só escreve a posição do mouse; o brilho é gradiente do CSS. */\n  armarLuz() {\n    if (!window.matchMedia('(hover: hover)').matches) return;\n    const cartoes = Array.prototype.slice.call(document.querySelectorAll('.mf-luz'));\n    cartoes.forEach((c) => {\n      const brilho = document.createElement('span');\n      const cor = c.getAttribute('data-luz');\n      brilho.style.cssText = 'position:absolute;inset:0;pointer-events:none;opacity:0;transition:opacity .4s ease;background:radial-gradient(260px circle at var(--mf-x,50%) var(--mf-y,50%),' + cor + ',transparent 66%)';\n      c.appendChild(brilho);\n      c.addEventListener('pointermove', (e) => {\n        const r = c.getBoundingClientRect();\n        c.style.setProperty('--mf-x', ((e.clientX - r.left) / r.width * 100).toFixed(2) + '%');\n        c.style.setProperty('--mf-y', ((e.clientY - r.top) / r.height * 100).toFixed(2) + '%');\n        brilho.style.opacity = '1';\n      });\n      c.addEventListener('pointerleave', () => { brilho.style.opacity = '0'; });\n    });\n  }\n\n  /* 14 — mola de verdade nas chamadas principais: rigidez e amortecimento\n     calculados a cada quadro, então o botão oscila e assenta sozinho. */\n  armarMola() {\n    const botoes = Array.prototype.slice.call(document.querySelectorAll('.mf-mola'));\n    botoes.forEach((b) => {\n      let esc = 1, vel = 0, alvo = 1, laco = null;\n      const passo = () => {\n        vel = (vel + (alvo - esc) * 0.18) * 0.74;\n        esc += vel;\n        if (Math.abs(vel) > 0.0005 || Math.abs(alvo - esc) > 0.0005) {\n          b.style.transform = 'scale(' + esc.toFixed(4) + ')';\n          laco = requestAnimationFrame(passo);\n        } else {\n          esc = alvo; laco = null;\n          b.style.transform = alvo === 1 ? '' : 'scale(' + alvo + ')';\n        }\n      };\n      const puxar = (v) => { alvo = v; if (!laco) laco = requestAnimationFrame(passo); };\n      b.addEventListener('pointerenter', () => puxar(1.04));\n      b.addEventListener('pointerleave', () => puxar(1));\n      b.addEventListener('pointerdown', () => puxar(0.96));\n      b.addEventListener('pointerup', () => puxar(1.04));\n      this._molas = (this._molas || []).concat(laco);\n    });\n  }\n\n  componentWillUnmount() {\n    if (this._io) this._io.disconnect();\n    if (this._timer) clearInterval(this._timer);\n    if (this._resize) window.removeEventListener('resize', this._resize);\n    if (this._aoRolar) { window.removeEventListener('scroll', this._aoRolar); window.removeEventListener('resize', this._aoRolar); }\n  }\n\n  renderVals() { return {}; }\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
  </script>
</body>
</html>